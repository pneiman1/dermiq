# DermIQ environment configuration template
# Copy this file to .env and fill in real values. Never commit .env.
#
# DermIQ reads most of its settings through platform-core's Settings object
# (platform_core.config.get_settings), so the variable names below match what
# platform-core expects. DermIQ-specific variables are grouped at the bottom.

# === Environment ===
ENVIRONMENT=dev
LOG_LEVEL=INFO

# === Snowflake (analytics warehouse target) ===
# Account format: <orglocator>-<accountname> e.g. kyhyqgt-rk09884
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Keypair auth (preferred): Snowflake enforces MFA on password auth,
# which cannot complete headless. See dermiq docs/DECISIONS.md ADR-009.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Fallback only; unused while SNOWFLAKE_PRIVATE_KEY_PATH is set.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DERMIQ_DEV

# === LLM provider ===
# 'anthropic' for direct API (dev) or 'bedrock' for AWS Bedrock (prod with PHI)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Monthly budget cap for Anthropic API calls (USD). Set to 0 to disable.
ANTHROPIC_MONTHLY_BUDGET_USD=20.0

# === Embeddings ===
# 'sentence_transformers' — free, local, torch-based. The reference backend; use
#   it for local dev and for corpus builds.
# 'onnx' — the same all-MiniLM-L6-v2 weights via ONNX Runtime, ~90MB of deps
#   instead of ~1.2GB. What the API container runs (Dockerfile.api sets it, and
#   bakes the model into ONNX_MODEL_DIR). Setting this locally also requires a
#   model directory on disk, so leave it alone unless you have one.
# 'voyage' — higher quality, needs a key. Scaffolded in config, not wired yet.
# Both local backends produce identical vectors, so a corpus embedded by one is
# queryable by the other. See docs/DECISIONS.md ADR-014.
EMBEDDING_PROVIDER=sentence_transformers

# === Application database (Postgres + pgvector) ===
DATABASE_URL=postgresql://dermiq:dermiq@localhost:5432/dermiq
PGVECTOR_DIMENSIONS=384

# === Local dev defaults ===
DEFAULT_TENANT_ID=del_mar

# === API CORS ===
# Comma-separated list of allowed origins. Falls back to localhost for dev.
# For production: CORS_ORIGINS=https://dermiq.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# === DermIQ: source EMR database ===
# The Nextech-shaped Postgres source DB defined in docker-compose.yml.
# The seed loader (scripts/seed_postgres.py) writes here; ingestion reads here.
# Defaults to the docker-compose credentials if unset.
POSTGRES_SOURCE_URL=postgresql://dermiq:dermiq_local_only@localhost:5432/del_mar_source
