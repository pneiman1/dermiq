# Environment & secrets
.env
.env.local
*.pem
*.key
*.p8
secrets/
# Deploy secrets staged for `fly secrets import` — holds the Anthropic key and
# the Snowflake key passphrase in plaintext. Was untracked but not ignored.
dermiq-secrets.env
*secrets.env

# Docker
# flyctl regenerates a repo-root .dockerignore from this file on deploy. It is
# dead weight: Dockerfile.api builds from the PARENT of this repo (it needs the
# sibling platform-core/), so Docker resolves the context-root .dockerignore at
# ~/projects, never here. Dockerfile.api.dockerignore is the one that applies
# and is tracked. Ignoring this keeps the regenerated copy out of git status —
# it does not stop flyctl from writing the file.
/.dockerignore

