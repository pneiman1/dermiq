# DermIQ API Dockerfile (chunk-13)
#
# Multi-stage build for the FastAPI backend. Designed for Fly.io deployment.
#
# Build: docker build -f Dockerfile.api -t dermiq-api .
# Run:   docker run -p 8000:8000 --env-file .env dermiq-api
#
# For Fly.io, secrets are set via `fly secrets set KEY=value`. The Snowflake
# private key is passed as SNOWFLAKE_PRIVATE_KEY_CONTENT (base64-encoded) and
# decoded to /secrets/snowflake_rsa_key.p8 by docker-entrypoint.sh, which also
# exports SNOWFLAKE_PRIVATE_KEY_PATH. The container refuses to start without it.

# -----------------------------------------------------------------------------
# Stage 1: Build dependencies
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies for cryptography + snowflake-connector
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy platform-core first (changes less frequently)
COPY platform-core /build/platform-core/
RUN pip install --no-cache-dir /build/platform-core

# Copy dermiq and install with api + rag extras
COPY dermiq /build/dermiq/
RUN pip install --no-cache-dir "/build/dermiq[api,rag]"

# -----------------------------------------------------------------------------
# Stage 2: Runtime image
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libffi8 \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy the dermiq package (for any data files / scripts)
COPY dermiq /app/dermiq/
COPY platform-core /app/platform-core/

# Copy entrypoint script (decodes the base64 Snowflake key at startup)
COPY dermiq/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Non-root user for security
RUN useradd --create-home --shell /bin/bash appuser

# Secrets dir must exist and be writable by appuser: the entrypoint decodes the
# private key here at runtime, and a non-root process cannot mkdir under /.
RUN mkdir -p /secrets && chown appuser:appuser /secrets && chmod 700 /secrets

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["uvicorn", "dermiq.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
